<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lyric Float"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_notification_access"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Grant Notification Access"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Display Toggles Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Options"
                    android:textStyle="bold"
                    android:textColor="?android:attr/colorPrimary"
                    android:layout_marginBottom="12dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_start_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Dynamic Lyrics"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:paddingVertical="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#33888888"
                    android:layout_marginVertical="8dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_floating_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Floating Box"
                    android:textSize="16sp"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show in Notification Panel"
                    android:textSize="16sp"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_lock_screen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show on Lock Screen"
                    android:textSize="16sp"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_widget_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use Album Art on Widget"
                    android:textSize="16sp"
                    android:paddingVertical="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Customization Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customization"
                    android:textStyle="bold"
                    android:textColor="?android:attr/colorPrimary"
                    android:layout_marginBottom="16dp"/>

                <!-- Live Preview Box -->
                <LinearLayout
                    android:id="@+id/preview_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_bg_semi_transparent">

                    <TextView
                        android:id="@+id/preview_prev"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This is the previous line"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/preview_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This is the current singing line"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginVertical="4dp" />

                    <TextView
                        android:id="@+id/preview_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This is the next line"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Background Color Input -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Background (Hex)"
                            android:textSize="12sp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <EditText
                                android:id="@+id/et_bg_color"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:singleLine="true" />
                            <Button
                                android:id="@+id/btn_pick_bg_color"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="48dp"
                                android:text="🎨"
                                style="?android:attr/borderlessButtonStyle" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Text Color Input -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Text Color (Hex)"
                            android:textSize="12sp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <EditText
                                android:id="@+id/et_text_color"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:inputType="textNoSuggestions"
                                android:singleLine="true" />
                            <Button
                                android:id="@+id/btn_pick_text_color"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="48dp"
                                android:text="🎨"
                                style="?android:attr/borderlessButtonStyle" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_save_colors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Apply Colors"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    style="?android:attr/borderlessButtonStyle"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Background Transparency"
                    android:layout_gravity="center" />

                <SeekBar
                    android:id="@+id/seek_transparency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="255"
                    android:layout_marginVertical="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default Visible Lines"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/seek_default_lines"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="4"
                    android:progress="1"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Presets Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preset Themes"
                    android:textStyle="bold"
                    android:textColor="?android:attr/colorPrimary"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_theme_dark"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Dark"
                        android:layout_marginEnd="4dp"
                        style="?android:attr/borderlessButtonStyle"/>

                    <Button
                        android:id="@+id/btn_theme_light"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Light"
                        android:layout_marginHorizontal="4dp"
                        style="?android:attr/borderlessButtonStyle"/>

                    <Button
                        android:id="@+id/btn_theme_green"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Green"
                        android:layout_marginStart="4dp"
                        style="?android:attr/borderlessButtonStyle"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>