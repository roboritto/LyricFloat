<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <!-- Header -->
        <TextView
            android:id="@+id/main_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lyric Float"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="#8294C4"
            android:gravity="center"
            android:layout_marginTop="64dp"
            android:layout_marginBottom="64dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_notification_access"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="GRANT NOTIFICATION ACCESS"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/bg_button_rounded"
            android:backgroundTint="#8294C4"
            android:layout_marginBottom="24dp" />

        <!-- Card 1: Display Options -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#4B5E87"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Options"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_start_service"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Lyric Float"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="4dp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_floating_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Floating Box"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="4dp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_notification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show in Notification Panel"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="4dp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_lock_screen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show on Lock Screen"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="4dp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_widget_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use Album Art on Widget Screen"
                    android:textColor="#FFFFFF"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 2: Floating Box Customization -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#4B5E87"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Floating Box Customization"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/preview_container_float"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/rounded_bg_semi_transparent">
                    <TextView android:id="@+id/preview_float_prev2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the line before" android:textSize="12sp" />
                    <TextView android:id="@+id/preview_float_prev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the previous line" android:textSize="14sp" />
                    <TextView android:id="@+id/preview_float_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the current singing line" android:textSize="16sp" android:textStyle="bold" android:layout_marginVertical="4dp" />
                    <TextView android:id="@+id/preview_float_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the next line" android:textSize="14sp" />
                    <TextView android:id="@+id/preview_float_next2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the line after" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Background Color" android:textColor="#FFFFFF" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText android:id="@+id/et_float_bg_color" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="textNoSuggestions" android:singleLine="true" />
                            <Button android:id="@+id/btn_pick_float_bg_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="🎨" style="?android:attr/borderlessButtonStyle" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Text Color" android:textColor="#FFFFFF" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText android:id="@+id/et_float_text_color" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="textNoSuggestions" android:singleLine="true" />
                            <Button android:id="@+id/btn_pick_float_text_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="🎨" style="?android:attr/borderlessButtonStyle" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Floating Box Transparency" android:textColor="#FFFFFF" />
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#FFFFFF" android:layout_alignParentStart="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50%" android:textColor="#FFFFFF" android:layout_centerHorizontal="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#FFFFFF" android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <SeekBar android:id="@+id/seek_float_transparency" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Floating Box Default Number of Lines" android:textColor="#FFFFFF" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="16dp" android:paddingRight="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#FFFFFF" />
                    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#FFFFFF" />
                    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#FFFFFF" />
                    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#FFFFFF" />
                    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#FFFFFF" />
                </LinearLayout>
                <SeekBar android:id="@+id/seek_float_lines" style="@style/Widget.AppCompat.SeekBar.Discrete" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="4" android:progress="2" android:layout_marginBottom="16dp"/>

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_apply_float" android:layout_width="match_parent" android:layout_height="48dp" android:text="Apply Settings" android:textStyle="bold" android:textColor="#000000" android:backgroundTint="#8294C4" android:background="@drawable/bg_button_rounded" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 3: Floating Box Color Presets -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#4B5E87"
            app:cardCornerRadius="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Floating Box Color Presets" android:textColor="#FFFFFF" android:layout_marginBottom="12dp"/>
                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_float_theme_dark"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Dark"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#222222"
                        android:background="@drawable/bg_button_rounded"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_float_theme_light"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Light"
                        android:textColor="#000000"
                        android:backgroundTint="#FFFFFF"
                        android:background="@drawable/bg_button_rounded"
                        android:layout_marginHorizontal="4dp" />

                    <Button
                        android:id="@+id/btn_float_theme_green"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Green" android:textColor="#FFFFFF" android:backgroundTint="#1DB954" android:background="@drawable/bg_button_rounded" android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 4: Widget Customization -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#4B5E87"
            app:cardCornerRadius="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Widget Customisation" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="16sp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:id="@+id/preview_container_widget" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="24dp" android:layout_marginBottom="16dp" android:background="@drawable/rounded_bg_semi_transparent">
                    <TextView android:id="@+id/preview_widget_prev2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the line before" android:textSize="12sp" />
                    <TextView android:id="@+id/preview_widget_prev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the previous line" android:textSize="14sp" />
                    <TextView android:id="@+id/preview_widget_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the current singing line" android:textSize="16sp" android:textStyle="bold" android:layout_marginVertical="4dp" />
                    <TextView android:id="@+id/preview_widget_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the next line" android:textSize="14sp" />
                    <TextView android:id="@+id/preview_widget_next2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="This is the line after" android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Background Color" android:textColor="#FFFFFF" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText android:id="@+id/et_widget_bg_color" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="textNoSuggestions" android:singleLine="true" />
                            <Button android:id="@+id/btn_pick_widget_bg_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="🎨" style="?android:attr/borderlessButtonStyle" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Text Color" android:textColor="#FFFFFF" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText android:id="@+id/et_widget_text_color" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="textNoSuggestions" android:singleLine="true" />
                            <Button android:id="@+id/btn_pick_widget_text_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="🎨" style="?android:attr/borderlessButtonStyle" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Widget Transparency" android:textColor="#FFFFFF" />
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textColor="#FFFFFF" android:layout_alignParentStart="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50%" android:textColor="#FFFFFF" android:layout_centerHorizontal="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#FFFFFF" android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <SeekBar android:id="@+id/seek_widget_transparency" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="255" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Widget Number of Lines" android:textColor="#FFFFFF" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingLeft="16dp" android:paddingRight="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="#FFFFFF" />
                    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="#FFFFFF" />
                    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#FFFFFF" />
                    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textColor="#FFFFFF" />
                    <Space android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textColor="#FFFFFF" />
                </LinearLayout>
                <SeekBar android:id="@+id/seek_widget_lines" style="@style/Widget.AppCompat.SeekBar.Discrete" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="4" android:progress="4" android:layout_marginBottom="16dp"/>

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_apply_widget" android:layout_width="match_parent" android:layout_height="48dp" android:text="Apply Settings" android:textStyle="bold" android:textColor="#000000" android:backgroundTint="#8294C4" android:background="@drawable/bg_button_rounded" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 5: Widget Color Presets (UPDATED ALBUM TO GREEN) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#4B5E87"
            app:cardCornerRadius="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Widget Color Presets" android:textColor="#FFFFFF" android:layout_marginBottom="12dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_widget_theme_dark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Dark" android:textColor="#FFFFFF" android:backgroundTint="#222222" android:background="@drawable/bg_button_rounded" android:layout_marginEnd="4dp"/>
                    <Button android:id="@+id/btn_widget_theme_light" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Light" android:textColor="#000000" android:backgroundTint="#FFFFFF" android:background="@drawable/bg_button_rounded" android:layout_marginHorizontal="4dp"/>
                    <Button android:id="@+id/btn_widget_theme_accent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Accent" android:textColor="#FFFFFF" android:backgroundTint="#FF5E3E" android:background="@drawable/bg_button_rounded" android:layout_marginStart="2dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card 6: NEW APP THEME CUSTOMISATION -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#4B5E87"
            app:cardCornerRadius="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App Theme Customisation" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="16sp" android:layout_marginBottom="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App Background" android:textColor="#FFFFFF" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText android:id="@+id/et_app_bg_color" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="textNoSuggestions" android:singleLine="true" />
                            <Button android:id="@+id/btn_pick_app_bg_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="🎨" style="?android:attr/borderlessButtonStyle" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Card Color" android:textColor="#FFFFFF" android:textSize="12sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <EditText android:id="@+id/et_app_card_color" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="textNoSuggestions" android:singleLine="true" />
                            <Button android:id="@+id/btn_pick_app_card_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="🎨" style="?android:attr/borderlessButtonStyle" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App Text Color" android:textColor="#FFFFFF" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <EditText android:id="@+id/et_app_text_color" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:inputType="textNoSuggestions" android:singleLine="true" />
                        <Button android:id="@+id/btn_pick_app_text_color" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="48dp" android:text="🎨" style="?android:attr/borderlessButtonStyle" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_apply_app" android:layout_width="match_parent" android:layout_height="48dp" android:text="Apply App Theme" android:textStyle="bold" android:textColor="#000000" android:background="@drawable/bg_button_rounded" android:layout_marginBottom="16dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="App Theme Presets" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btn_app_theme_default" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Default" android:textColor="#FFFFFF" android:backgroundTint="#4B5E87" android:background="@drawable/bg_button_rounded" android:layout_marginEnd="4dp"/>
                    <Button android:id="@+id/btn_app_theme_dark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Dark" android:textColor="#FFFFFF" android:backgroundTint="#222222" android:background="@drawable/bg_button_rounded" android:layout_marginHorizontal="4dp"/>
                    <Button android:id="@+id/btn_app_theme_light" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Light" android:textColor="#000000" android:backgroundTint="#FFFFFF" android:background="@drawable/bg_button_rounded" android:layout_marginStart="4dp"/>
