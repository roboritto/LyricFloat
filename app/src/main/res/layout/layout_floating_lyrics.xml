<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lyrics_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/rounded_bg_semi_transparent"
    android:gravity="center_vertical">

    <!-- Dedicated Drag Handle (Left Side) -->
    <LinearLayout
        android:id="@+id/dedicated_drag_handle"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:minHeight="48dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- A simple visual grip line -->
        <View
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="#80FFFFFF" />
    </LinearLayout>

    <!-- Dynamic Lyrics (Takes up remaining space) -->
    <TextView
        android:id="@+id/tv_dynamic_lyrics"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:textStyle="bold" />

</LinearLayout>